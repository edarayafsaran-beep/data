rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Is user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    match /branches/{branchId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /treatments/{treatmentId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /inventory/{itemId} {
      allow read, write: if true;
    }

    match /whatsappLogs/{logId} {
      allow read, write: if true;
    }

    match /treatmentPackages/{packageId} {
      allow read, write: if true;
    }

    match /membershipTiers/{tierId} {
      allow read, write: if true;
    }

    match /patientComplaints/{complaintId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /labTests/{testId} {
      allow read, write: if true;
    }

    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    match /systemAuditLogs/{logId} {
      allow read, write: if true;
    }

    match /employeePayroll/{recordId} {
      allow read, write: if true;
    }

    match /cashBoxes/{boxId} {
      allow read, write: if true;
    }

    match /bankAccounts/{accountId} {
      allow read, write: if true;
    }

    match /fixedAssets/{assetId} {
      allow read, write: if true;
    }

    match /financialAuditLogs/{logId} {
      allow read, write: if true;
    }

    match /employeeBonuses/{bonusId} {
      allow read, write: if true;
    }

    match /staffAttendance/{attendanceId} {
      allow read, write: if true;
    }

    match /staffLeaveRequests/{requestId} {
      allow read, write: if true;
    }

    match /workShiftConfigs/{configId} {
      allow read, write: if true;
    }

    match /systemSettings/{settingId} {
      allow read, write: if true;
    }

    match /customFormFields/{fieldId} {
      allow read, write: if true;
    }

    match /campaigns/{campaignId} {
      allow read, write: if true;
    }

    // Permissive match for all collections
    match /{collection}/{documentId} {
      allow read, write: if true;
    }
  }
}
